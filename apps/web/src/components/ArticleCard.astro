---
import type { Article, ArticleWithCategory } from "../lib/directus";
import { excerpt, formatDate, publishedDate, resolveArticleImage } from "../lib/directus";

interface Props {
  article: Article | ArticleWithCategory;
  categoryName?: string;
  categorySlug?: string;
  priority?: boolean;
}

const { article, categoryName, categorySlug, priority = false } = Astro.props;
const image = resolveArticleImage(article, categorySlug);
const publishedIso = publishedDate(article);
const date = formatDate(publishedIso);
const summary = excerpt(article.text_content, 220);
---
<article class="card">
  <div class="card-media">
    {
      image ? (
        <img
          src={image.src}
          alt={article.title}
          width="1200"
          height="675"
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : undefined}
          decoding="async"
        />
      ) : (
        <div class="card-placeholder" aria-hidden="true">kombAIn.pl</div>
      )
    }
  </div>
  <div class="card-body">
    {
      categoryName && categorySlug && (
        <a class="card-category" href={`/kategoria/${categorySlug}`}>
          {categoryName}
        </a>
      )
    }
    <h3 class="card-title">
      <a href={`/artykul/${article.slug}`}>{article.title}</a>
    </h3>
    {date && <time class="card-date" datetime={publishedIso ?? undefined}>{date}</time>}
    {summary && <p class="card-excerpt">{summary}</p>}
    <span class="card-more" aria-hidden="true">Dowiedz się więcej →</span>
  </div>
</article>
