---
import type { TechSummary } from "../lib/directus";

interface Props {
  summary: TechSummary | null;
}

const { summary } = Astro.props;
---
{
  summary && (
    <section class="box tech-summary" aria-labelledby="tech-heading">
      <h2 id="tech-heading">Tech summary</h2>
      <table class="tech-table">
        <caption class="visually-hidden">Podsumowanie techniczne artykułu</caption>
        <tbody>
          <tr>
            <th scope="row">Podmiot</th>
            <td>{summary.podmiot}</td>
          </tr>
          <tr>
            <th scope="row">Technologia</th>
            <td>{summary.technologia}</td>
          </tr>
          <tr>
            <th scope="row">Cel wdrożenia</th>
            <td>{summary.cel_wdrozenia}</td>
          </tr>
        </tbody>
      </table>
    </section>
  )
}
