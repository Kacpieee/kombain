---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---
{
  items.length > 0 && (
    <section class="box tldr" aria-labelledby="tldr-heading">
      <h2 id="tldr-heading">TL;DR</h2>
      <ul>
        {items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
  )
}
