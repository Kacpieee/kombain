---
import type { Category } from "../lib/directus";

interface Props {
  categories: Category[];
  activeCategory?: string;
  currentPath: string;
}

const { categories, activeCategory, currentPath } = Astro.props;
const isHome = currentPath === "/";
---
<header class="site-header" data-site-header>
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="kombain.pl — strona główna">
      kombain<span>.pl</span>
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-nav-toggle
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <span>Menu</span>
    </button>

    <nav id="primary-nav" class="site-nav" aria-label="Kategorie" data-site-nav>
      <ul class="nav-list">
        <li>
          <a href="/" aria-current={isHome ? "page" : undefined}>Najnowsze</a>
        </li>
        {
          categories.map((category) => {
            const href = `/kategoria/${category.slug}`;
            const isCurrentCategoryPage = currentPath === href || currentPath === `${href}/`;
            const isActiveSection = !isCurrentCategoryPage && category.slug === activeCategory;
            return (
              <li>
                <a
                  href={href}
                  aria-current={isCurrentCategoryPage ? "page" : undefined}
                  class:list={{ "is-section": isActiveSection }}
                >
                  {category.name}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const nav = header?.querySelector<HTMLElement>("[data-site-nav]");

  if (header && toggle && nav) {
    const desktopQuery = window.matchMedia("(min-width: 64rem)");

    const setExpanded = (expanded: boolean) => {
      toggle.setAttribute("aria-expanded", String(expanded));
      nav.hidden = !desktopQuery.matches && !expanded;
    };

    header.dataset.navReady = "true";
    setExpanded(false);

    toggle.addEventListener("click", () => {
      const next = toggle.getAttribute("aria-expanded") !== "true";
      setExpanded(next);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setExpanded(false);
        toggle.focus();
      }
    });

    desktopQuery.addEventListener("change", () => {
      setExpanded(false);
    });
  }
</script>
