---
import type { Category } from "../lib/directus";

interface Props {
  title: string;
  description?: string;
  categories?: Category[];
  activeCategory?: string;
}

const {
  title,
  description = "kombain.pl — technologia, która uprawia. AgTech, rolnictwo precyzyjne, drony i agroenergetyka.",
  categories = [],
  activeCategory,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const pageTitle = title.includes("kombain.pl") ? title : `${title} — kombain.pl`;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="kombain.pl" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#1f5c3a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Przejdź do treści</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="kombain.pl — strona główna">
          kombain<span>.pl</span>
        </a>
        <nav class="category-nav" aria-label="Kategorie">
          <a href="/" class:list={{ active: !activeCategory }}>Najnowsze</a>
          {
            categories.map((category) => (
              <a
                href={`/kategoria/${category.slug}`}
                class:list={{ active: category.slug === activeCategory }}
              >
                {category.name}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <p><strong>kombain.pl</strong> — AgTech bez ściemy. Fakty z linkiem do źródła.</p>
        <p class="muted">Treści generowane automatycznie i weryfikowane względem źródeł.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --green-900: #143d27;
    --green-700: #1f5c3a;
    --green-500: #2f8a55;
    --green-100: #e6f2ea;
    --earth-100: #f6f3ec;
    --earth-200: #e9e2d3;
    --ink: #1c2420;
    --muted: #5a6860;
    --white: #ffffff;
    --radius: 14px;
    --shadow: 0 8px 28px rgb(20 61 39 / 10%);
    --max-width: 1120px;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: var(--ink);
    background: var(--earth-100);
    line-height: 1.65;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  a {
    color: var(--green-700);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  a:hover {
    color: var(--green-500);
  }

  img {
    max-width: 100%;
    height: auto;
  }

  .shell {
    width: min(100% - 2rem, var(--max-width));
    margin-inline: auto;
  }

  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--green-900);
    color: var(--white);
    padding: 0.6rem 1rem;
    z-index: 100;
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
  }

  .site-header {
    background: var(--green-900);
    color: var(--white);
    border-bottom: 4px solid var(--green-500);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 0.9rem;
  }

  .brand {
    color: var(--white);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .brand span {
    color: #9fd4b2;
  }

  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    font-size: 0.82rem;
    font-weight: 650;
  }

  .category-nav a {
    color: #d9eadf;
    text-decoration: none;
    padding: 0.25rem 0.1rem;
    border-bottom: 2px solid transparent;
  }

  .category-nav a:hover,
  .category-nav a.active {
    color: var(--white);
    border-bottom-color: #9fd4b2;
  }

  .site-footer {
    margin-top: 4rem;
    padding-block: 2rem;
    background: var(--green-900);
    color: #d9eadf;
    font-size: 0.85rem;
  }

  .footer-inner p {
    margin: 0.25rem 0;
  }

  .muted {
    color: var(--muted);
  }

  .site-footer .muted {
    color: #a8c4b3;
  }

  .hero {
    padding-block: 3.2rem 2.2rem;
  }

  .eyebrow {
    display: inline-block;
    margin: 0 0 0.6rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--green-100);
    color: var(--green-700);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--green-900);
  }

  .hero p {
    max-width: 62ch;
    margin: 1rem 0 0;
    font-size: 1.05rem;
    color: var(--muted);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1.35rem;
    color: var(--green-900);
  }

  .section-heading span {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.2rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--earth-200);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .card-media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(135deg, var(--green-100), var(--earth-200));
    text-decoration: none;
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .card-media:hover img {
    transform: scale(1.03);
  }

  .card-placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-size: 2.4rem;
  }

  .card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1rem 1.1rem 1.2rem;
  }

  .card-category {
    align-self: flex-start;
    color: var(--green-700);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .card h3 {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.3;
  }

  .card h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .card h3 a:hover {
    color: var(--green-700);
  }

  .card-excerpt {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .card-date {
    margin-top: auto;
    padding-top: 0.35rem;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category-chip {
    display: inline-block;
    padding: 0.5rem 0.85rem;
    background: var(--white);
    border: 1px solid var(--earth-200);
    border-radius: 999px;
    color: var(--green-900);
    font-size: 0.85rem;
    font-weight: 650;
    text-decoration: none;
  }

  .category-chip:hover {
    border-color: var(--green-500);
    background: var(--green-100);
  }

  .article-header {
    padding-block: 2.6rem 1.6rem;
    max-width: 820px;
  }

  .article-header h1 {
    margin: 0.4rem 0 0.8rem;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--green-900);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .article-hero {
    margin: 0 0 1.8rem;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .article-hero img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 860px) {
    .article-layout {
      grid-template-columns: 1fr;
    }
  }

  .article-body {
    font-size: 1.02rem;
  }

  .article-body h2,
  .article-body h3 {
    margin-top: 1.8em;
    line-height: 1.25;
    color: var(--green-900);
  }

  .article-body p {
    margin: 0 0 1em;
  }

  .article-body ul,
  .article-body ol {
    padding-left: 1.4rem;
  }

  .article-body li {
    margin-bottom: 0.35em;
  }

  .article-body strong {
    color: var(--green-900);
  }

  .source-line {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--earth-200);
    font-size: 0.85rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .sidebar {
    display: grid;
    gap: 1rem;
  }

  .box {
    padding: 1.1rem 1.2rem;
    background: var(--white);
    border: 1px solid var(--earth-200);
    border-radius: var(--radius);
  }

  .box h2 {
    margin: 0 0 0.6rem;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--green-700);
  }

  .box ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .box li {
    margin-bottom: 0.4rem;
  }

  .tech-summary dl {
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }

  .tech-summary dt {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .tech-summary dd {
    margin: 0.1rem 0 0;
    font-size: 0.9rem;
  }

  .not-found {
    padding-block: 4rem;
  }

  .not-found h1 {
    color: var(--green-900);
  }
</style>
